#!/usr/bin/env sh
# Husky pre-push — Constitution CI §1 + §3 (Notifuse Veridian)
#
# Bloque le push si check-test-mapping.sh sort en erreur.
# Fail-safe : si le script est introuvable OU non exécutable, le hook
# BLOQUE le push (pas exit 0 silencieux). Mieux : refuser un push légitime
# qu'autoriser un push qui contourne involontairement la discipline.

set -eu

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

SCRIPT="scripts/ci/check-test-mapping.sh"

if [ ! -f "$SCRIPT" ]; then
  echo "${RED}✗ $SCRIPT introuvable — hook pre-push refuse le push.${NC}"
  echo "  Restaure le script ou commit-le, puis re-tente."
  echo "  (Constitution CI §1 : 1 fichier critique = 1 test colocalisé bloquant.)"
  exit 1
fi

if [ ! -x "$SCRIPT" ]; then
  echo "${RED}✗ $SCRIPT non exécutable — hook pre-push refuse le push.${NC}"
  echo "  Run: chmod +x $SCRIPT && make setup-hooks"
  exit 1
fi

# ─── Détermine BASE_REF en lisant stdin (refs du push en cours) ─────────────
# Git passe sur stdin : <local_ref> <local_sha> <remote_ref> <remote_sha>
# Une ligne par ref poussée. On prend le premier remote_sha non-zéro comme
# point de comparaison réel (le tip distant actuel de la branche poussée).
# Si rien sur stdin (push --no-stdin ou hook lancé manuellement) → fallback.

ZERO="0000000000000000000000000000000000000000"
REMOTE_SHA=""
while IFS=' ' read -r _local_ref _local_sha remote_ref remote_sha; do
  [ -z "${remote_sha:-}" ] && continue
  if [ "$remote_sha" != "$ZERO" ]; then
    REMOTE_SHA="$remote_sha"
    break
  fi
done || true

if [ -n "$REMOTE_SHA" ]; then
  BASE_REF="$REMOTE_SHA"
elif [ -n "${BASE_REF:-}" ]; then
  : # Explicit local/CI override (useful from a detached clean worktree).
else
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
  BASE_REF="origin/${CURRENT_BRANCH}"
  if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null 2>&1; then
    # New feature branches in this fork are based on the long-lived staging
    # branch `veridian`. Comparing them to `main` (production) incorrectly
    # treats every pending staging commit as part of the current push.
    BASE_REF="origin/veridian"
  fi
  if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null 2>&1; then
    BASE_REF="origin/main"
  fi
  if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null 2>&1; then
    BASE_REF="HEAD~1"
  fi
fi

export BASE_REF
echo "${GREEN}── Husky pre-push (Constitution CI §1) ──${NC}"
echo "  BASE_REF=$BASE_REF"

if ! "$SCRIPT"; then
  echo
  echo "${RED}✗ Push refusé par Husky.${NC}"
  echo "  ${YELLOW}Ne JAMAIS bypasser avec --no-verify (Constitution CI §3).${NC}"
  echo "  Corrige les violations puis re-tente."
  exit 1
fi

# ─── Garde-fou « rate-limit global de l'API » (OWASP API4) ──────────────────
# Vérifie que le middleware VeridianAPIRateLimitMiddleware est toujours câblé
# dans app.go (sinon TOUTE l'API authentifiée perd son rate-limit) et alerte
# si un mux HTTP parallèle non-wrappé apparaît. La règle de câblage est
# BLOQUANTE ; la détection de mux parallèle est informative (non bloquante).
# Toujours lancé (le rate-limit global est transverse, pas lié à un fichier
# précis du diff).

RATE_LIMIT_CHECK="scripts/ci/check-rate-limit-coverage.sh"

if [ -x "$RATE_LIMIT_CHECK" ]; then
  echo
  echo "${GREEN}── Husky pre-push : couverture rate-limit global (OWASP API4) ──${NC}"
  if ! "$RATE_LIMIT_CHECK"; then
    echo
    echo "${RED}✗ Push refusé : le rate-limit global de l'API est cassé ou absent.${NC}"
    echo "  ${YELLOW}Sans ce middleware, tous les endpoints authentifiés sont sans${NC}"
    echo "  ${YELLOW}rate-limit (Unrestricted Resource Consumption). Re-branche-le.${NC}"
    exit 1
  fi
elif [ -f "$RATE_LIMIT_CHECK" ]; then
  echo "${RED}✗ $RATE_LIMIT_CHECK présent mais non exécutable — push refusé.${NC}"
  echo "  Run: chmod +x $RATE_LIMIT_CHECK"
  exit 1
fi

# ─── Garde-fou « la console boote » ─────────────────────────────────────────
# Incident 2026-05-22 : un manualChunks Vite mal configuré a mis la console
# prod morte au boot, invisible pour les 225 tests unitaires. check-console-
# build.sh analyse le dist/ buildé (intégrité des chunks, chunk React
# atomique). Lancé UNIQUEMENT si le push touche console/ — sinon on ne
# rebuild pas la console pour rien sur un push purement backend.

CONSOLE_CHECK="scripts/ci/check-console-build.sh"

if git diff --name-only "$BASE_REF" HEAD 2>/dev/null | grep -q '^console/'; then
  echo
  echo "${GREEN}── Husky pre-push : console/ modifié → check build console ──${NC}"
  if [ ! -x "$CONSOLE_CHECK" ]; then
    echo "${RED}✗ $CONSOLE_CHECK introuvable ou non exécutable — push refusé.${NC}"
    echo "  Run: chmod +x $CONSOLE_CHECK"
    exit 1
  fi
  if ! "$CONSOLE_CHECK"; then
    echo
    echo "${RED}✗ Push refusé : le build de la console est cassé ou structurellement risqué.${NC}"
    echo "  ${YELLOW}Une console qui ne boote pas = prod morte. Corrige avant de pousser.${NC}"
    exit 1
  fi
fi

# Contrat GitOps Nomad co-localisé : criticité, RTO/RPO, staging obligatoire
# et images immuables sont vérifiés avant chaque push.
scripts/ci/check-nomad-contract.sh
