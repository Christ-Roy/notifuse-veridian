# .env.dev.example — config dev local pour cycle hot-reload rapide
#
# Usage : cp .env.dev.example .env && make dev-tailscale
#
# Toutes les valeurs sont OK pour du dev local. Le serveur écoute sur :8080
# Postgres test sur :5433 (compose tests/compose.test.yaml).
# Mailpit sur :1025 (SMTP) et :8025 (UI).

# ─── App ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8080
API_ENDPOINT=http://localhost:8080
LOG_LEVEL=debug
ROOT_EMAIL=root@dev.local

# ─── Postgres test (compose tests/compose.test.yaml) ─────────────────
# Override 5433 → 5434 si 5433 est occupé par un autre Postgres (ex verger).
# Le port doit être identique dans DB_PORT (consommé par l'app) ET dans
# NOTIFUSE_DB_TEST_PORT (consommé par docker compose pour publier).
DB_HOST=localhost
DB_PORT=5435
NOTIFUSE_DB_TEST_PORT=5435
DB_USER=notifuse_test
DB_PASSWORD=test_password
DB_NAME=postgres
DB_SSLMODE=disable

# ─── PASETO / JWT (clé de dev — générer via `make keygen`) ───────────
# Remplacer par output de make keygen
PASETO_PRIVATE_KEY=
PASETO_PUBLIC_KEY=

# ─── Hub Veridian — secrets HMAC ─────────────────────────────────────
# Récupérés depuis ~/credentials/.all-creds.env :
#   NOTIFUSE_HUB_API_SECRET    → HUB_API_SECRET (signe les requêtes Hub→Notifuse)
#   NOTIFUSE_HUB_WEBHOOK_SECRET → HUB_WEBHOOK_SECRET (signe les events Notifuse→Hub)
HUB_API_SECRET=
HUB_WEBHOOK_URL=
HUB_WEBHOOK_SECRET=
VERIDIAN_DEFAULT_PLAN=free

# ─── SMTP (Mailpit local) ────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@dev.local
SMTP_FROM_NAME=Notifuse Dev
SMTP_USE_TLS=false
